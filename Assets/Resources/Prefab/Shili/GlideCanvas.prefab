--- !u!114 &8895507388106157040
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1116867379677401264}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a31c456ed453b4249b8e63dfe45b1f5c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  index: 0
  text: {fileID: 243427957644803872}
  textStr:
  - "\u90A3\u91CC\u6709\u4E24\u4E2A\u65B9\u5757\u8BD5\u7740\u8D70\u4E0A\u53BB\u6467\u6BC1\u5B83\uFF01
    \uFF08\u6309\u4F4F J \u6467\u6BC1\u65B9\u5757\uFF09"
  - "\u5F88\u597D\uFF0C\u4F46\u662F\u6CE8\u610F\uFF01\u8FD9\u79CD\u65B9\u5757\u662F\u65E0\u6CD5\u88AB\u6467\u6BC1\u7684\uFF01"
  - "\u901A\u8FC7\u6467\u6BC1\uFF0C\u4F60\u83B7\u5F97\u4E86\u65B9\u5757\uFF0C\u73B0\u5728\u8BD5\u8BD5\u53BB\u653E\u7F6E\u5C5E\u4E8E\u4F60\u7684\u65B9\u5757\uFF08\u6309\u4E0BK\u653E\u7F6E\uFF09"
  - "\u8FD9\u4E00\u5217\u7684\u65B9\u5757\u5FEB\u5806\u6EE1\u4E86\uFF0C\u5806\u6EE1\u4E86\u6709\u597D\u4E8B\u53D1\u751F\uFF0C\u53BB\u8BD5\u8BD5\uFF01"
  - "\u50CF\u4FC4\u7F57\u65AF\u65B9\u5757\u4E00\u6837\uFF0C\u5806\u6EE1\u4E86\u65B9\u5757\u7684\u884C\u6216\u8005\u5217\u91CC\u9762\u7684\u65B9\u5757\u4F1A\u88AB\u6D88\u9664\uFF0C\u88AB\u6D88\u9664\u7684\u65B9\u5757\u4F1A\u4E3A\u4F60\u63D0\u4F9B\u80FD\u91CF"
  - "\u8C01\u5728\u88AB\u6D88\u9664\u7684\u65B9\u5757\u884C/\u5217\u4E2D\u653E\u7684\u65B9\u5757\u6700\u591A\uFF0C\u8C01\u83B7\u5F97\u7684\u80FD\u91CF\u6700\u591A"
  - "\u8FD9\u662F\u4F60\u7684\u8840\u6761\u548C\u80FD\u91CF\u6761\uFF0C\u8840\u6761\u7A7A\u4E86\u53EF\u5C31\u6B7B\u4E86\u3002\u4F60\u83B7\u5F97\u7684\u80FD\u91CF\u90FD\u4F1A\u79EF\u7D2F\u5728\u80FD\u91CF\u6761\u91CC\uFF0C\u83B7\u5F97\u8DB3\u591F\u7684\u80FD\u91CF\u65F6\uFF0C\u4F60\u5C31\u80FD\u6D88\u8017\u4E00\u5B9A\u80FD\u91CF\u6362\u53D6\u4E00\u4E2A\u5F3A\u529B\u7684\u968F\u673A\u7684\u9053\u5177\uFF01"
  - "\u73B0\u5728\u6211\u7ED9\u4F60\u4E24\u4E2A\u9053\u5177\u73A9\u73A9"
  - "\u8FD9\u662F\u6211\u7ED9\u4F60\u7684\u90A3\u4E24\u4E2A\u9053\u5177\uFF0C\u4F60\u65C1\u8FB9\u7684\u95EA\u7535\u56FE\u6807\u7684\u6570\u5B57\u662F\u4F60\u9009\u4E2D\u7684\u9053\u5177\u7684\u53EF\u4F7F\u7528\u6B21\u6570"
  - "\u73B0\u5728\u5207\u6362\u6210\u4F3D\u9A6C\u76FE\uFF0C\u518D\u8BD5\u7740\u4F7F\u7528\u5B83
    \uFF08\u6309I\u5207\u6362\u9053\u5177\uFF09\uFF08\u6309L\u4F7F\u7528\u9053\u5177\uFF09"
  - 
  - "\u4F3D\u9A6C\u76FE\u53EF\u4EE5\u7ED9\u4F60\u751F\u6210\u62B5\u6321\u4F24\u5BB3\u7684\u62A4\u76FE"
  - "WC\uFF0C\u521A\u521A\u4E0B\u9668\u77F3\u96E8\u4E86\uFF01\u8FD8\u597D\u4F60\u6709\u76FE\u6CA1\u88AB\u7838\u4F24\uFF01\u8FD9\u91CC\u7684\u7A7A\u95F4\u592A\u4E0D\u7A33\u5B9A\uFF0C\u7ECF\u5E38\u4F1A\u53D1\u751F\u4E00\u4E9B\u83AB\u540D\u5176\u5999\u7684\u968F\u673A\u4E8B\u4EF6\uFF0C\u8981\u5C0F\u5FC3\u6CE8\u610F\u4E86\uFF01"
  - "\u597D\u4E86\uFF0C\u73B0\u5728\u6211\u5DF2\u7ECF\u6CA1\u4EC0\u4E48\u53EF\u4EE5\u6559\u4F60\u7684\u4E86\uFF0C\u719F\u6089\u548C\u4E86\u89E3\u5404\u79CD\u9053\u5177\u7684\u4F7F\u7528\u548C\u968F\u673A\u4E8B\u4EF6\uFF0C\u8F6E\u5230\u4F60\u4E0A\u573A\u7684\u65F6\u5019\u4E86\uFF0C\u5C31\u60F3\u529E\u6CD5\u5F04\u6B7B\u5BF9\u9762\u90A3\u4E2A\u5B87\u822A\u5458\u5427\uFF01\uFF01"
  - "\u4EC0\u4E48\uFF1F\u4F60\u60F3\u77E5\u9053\u6FC0\u5149\u67AA\u7528\u6765\u5E72\u561B\uFF1F\u81EA\u5DF1\u53BB\u6218\u573A\u4E0A\u8BD5\u8BD5\u5427\uFF0C\u54C8\u54C8\u54C8\u54C8\uFF01"
